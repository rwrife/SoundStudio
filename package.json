{
  "name": "sound-studio",
  "productName": "Sound Studio",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first AI sound effects and music studio. Application shell.",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "icons": "npm run build && node scripts/generate-icon.mjs",
    "package": "npm run build && electron-builder --publish never",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "npm run build && node scripts/desktop-smoke.mjs",
    "screenshots": "npm run build && node scripts/desktop-smoke.mjs --screenshots"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "playwright": "1.64.1",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.rwrife.soundstudio",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": ["out/**/*", "package.json"],
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": "zip"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": "tar.gz",
      "category": "AudioVideo"
    }
  }
}
