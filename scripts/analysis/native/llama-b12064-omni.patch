 #include <iostream>
 #include <stdexcept>
 #include <string>
@@ -353,7 +354,89 @@ MAKE_TEST(test_audio_preprocessor_conformer) {
 // main
 //
 
+static clip_hparams omni_test_hparams(bool omni = true) {
+    clip_hparams hp;
+    hp.qwen25_omni_audio = omni;
+    hp.n_mel_bins = 128;
+    hp.audio_sample_rate = 16000;
+    hp.audio_n_fft = hp.audio_window_len = 400;
+    hp.audio_hop_len = 160;
+    return hp;
+}
+
+MAKE_TEST(test_audio_preprocessor_omni_lengths) {
+    mtmd_audio_preprocessor_whisper preproc(omni_test_hparams());
+    preproc.initialize();
+    for (size_t count : {0, 320, 321, 31839, 31840, 31999, 32000, 32001, 32160, 32161, 32321,
+                         159999, 160000, 160001, 479999, 480000, 480001}) {
+        std::vector<float> samples(count, 0.0f);
+        std::vector<mtmd_audio_mel> mels;
+        const bool valid = count > 320 && count <= 480000;
+        const auto label = std::to_string(count) + " samples";
+        t.assert_equal(label, valid, preproc.preprocess(samples.data(), samples.size(), mels));
+        if (!valid) {
+            t.assert_true(label + " has no output", mels.empty());
+            continue;
+        }
+        int64_t tokens = 0;
+        for (const auto & mel : mels) {
+            t.assert_true(label + " independent window", mel.n_len >= 3 && mel.n_len <= 200);
+            t.assert_equal(label + " valid frames retained", mel.n_len, mel.n_len_org);
+            t.assert_equal(label + " tensor size", (int64_t) mel.data.size(), mel.n_len * 128);
+            tokens += ((mel.n_len + 1) / 2) / 2;
+        }
+        const int64_t valid_frames = (count + 159) / 160;
+        t.assert_equal(label + " reference token count", (valid_frames + 1) / 4, tokens);
+    }
+
+    mtmd_audio_preprocessor_whisper legacy(omni_test_hparams(false));
+    legacy.initialize();
+    std::vector<float> samples(160000, 0.0f);
+    std::vector<mtmd_audio_mel> mels;
+    t.assert_true("legacy Whisper preprocessing", legacy.preprocess(samples.data(), samples.size(), mels));
+    t.assert_equal("legacy chunk count unchanged", (size_t) 1, mels.size());
+    t.assert_equal("legacy frame count unchanged", (int64_t) 3000, mels.at(0).n_len);
+}
+
+static int dump_omni_mel(const char * input, const char * output) {
+    std::ifstream in(input, std::ios::binary | std::ios::ate);
+    if (!in) {
+        throw std::runtime_error("Cannot open reference input");
+    }
+    const auto size = in.tellg();
+    if (size <= 0 || size > 480000 * (std::streamoff) sizeof(float) || size % sizeof(float) != 0) {
+        throw std::runtime_error("Invalid reference sample data");
+    }
+    std::vector<float> samples((size_t) size / sizeof(float));
+    in.seekg(0);
+    in.read((char *) samples.data(), size);
+    if (!in) {
+        throw std::runtime_error("Cannot read reference sample data");
+    }
+    mtmd_audio_preprocessor_whisper preproc(omni_test_hparams());
+    preproc.initialize();
+    std::vector<mtmd_audio_mel> mels;
+    if (!preproc.preprocess(samples.data(), samples.size(), mels)) {
+        return 1;
+    }
+    std::ofstream out(output, std::ios::binary | std::ios::trunc);
+    const uint64_t count = mels.size();
+    out.write((const char *) &count, sizeof(count));
+    for (const auto & mel : mels) {
+        out.write((const char *) &mel.n_len, sizeof(mel.n_len));
+        out.write((const char *) &mel.n_mel, sizeof(mel.n_mel));
+        out.write((const char *) mel.data.data(), mel.data.size() * sizeof(float));
+    }
+    if (!out) {
+        throw std::runtime_error("Cannot write reference output");
+    }
+    return 0;
+}
+
 int main(int argc, char ** argv) {
+    if (argc == 4 && std::string(argv[1]) == "--dump-omni-mel") {
+        return dump_omni_mel(argv[2], argv[3]);
+    }
     testing t(std::cout);
     t.verbose = true;
 
