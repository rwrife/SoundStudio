+bool mtmd_audio_preprocessor_whisper::preprocess_omni(
+        const float * samples, size_t n_samples, std::vector<mtmd_audio_mel> & output) const {
+    const size_t max_samples = (size_t) hparams.audio_sample_rate * 30;
+    const size_t n_valid = (n_samples + hparams.audio_hop_len - 1) / hparams.audio_hop_len;
+    if (n_samples > max_samples || n_valid < 3) {
+        LOG_ERR("%s: Qwen2.5-Omni requires 3 valid mel frames through 30 seconds of audio\n", __func__);
+        return false;
+    }
+
+    // Match WhisperFeatureExtractor padding=max_length, centered reflection,
+    // last-frame removal and the reference feature_attention_mask.
+    const size_t pad = hparams.audio_n_fft / 2;
+    std::vector<float> audio(max_samples, 0.0f);
+    std::copy_n(samples, n_samples, audio.begin());
+    std::vector<float> padded(max_samples + 2 * pad);
+    std::copy(audio.begin(), audio.end(), padded.begin() + pad);
+    std::reverse_copy(audio.begin() + 1, audio.begin() + pad + 1, padded.begin());
+    std::reverse_copy(audio.end() - pad - 1, audio.end() - 1, padded.end() - pad);
+
+    filter_params params;
+    params.n_mel = hparams.n_mel_bins;
+    params.n_fft_bins = 1 + hparams.audio_n_fft / 2;
+    params.hann_window_size = hparams.audio_window_len;
+    params.hop_length = hparams.audio_hop_len;
+    params.sample_rate = hparams.audio_sample_rate;
+    params.no_padding = true;
+    params.whisper_normalize = true;
+    params.drop_last_frame = true;
+    mtmd_audio_mel mel;
+    if (!log_mel_spectrogram(padded.data(), padded.size(), 4, params, cache, mel)) {
+        return false;
+    }
+    GGML_ASSERT(n_valid <= (size_t) mel.n_len);
+
+    // The pinned Omni encoder uses n_window=100: independent 200-mel-frame
+    // windows reset convolution boundaries, positions and attention. Existing
+    // graph pooling is equivalent because each full window has 100 CNN states.
+    for (size_t off = 0; off < n_valid; off += 200) {
+        const size_t count = std::min((size_t) 200, n_valid - off);
+        if (count < 3) {
+            // Its sole CNN state is discarded by the reference's final avgpool.
+            break;
+        }
+        mtmd_audio_mel chunk;
+        chunk.n_len = chunk.n_len_org = count;
+        chunk.n_mel = mel.n_mel;
+        chunk.data.reserve(count * mel.n_mel);
+        for (int64_t bin = 0; bin < mel.n_mel; ++bin) {
+            const auto begin = mel.data.begin() + bin * mel.n_len + off;
+            chunk.data.insert(chunk.data.end(), begin, begin + count);
+        }
+        output.push_back(std::move(chunk));
+    }
+    return !output.empty();
+}
